{
  "name": "n8n Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "forwardPorts": [5678],
  "portsAttributes": {
    "5678": {
      "label": "n8n Web UI",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postStartCommand": "docker compose up -d"
}
